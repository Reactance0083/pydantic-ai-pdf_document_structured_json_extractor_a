# ============================================================
# PDF/Document → Structured JSON Extractor API
# Environment Variables Configuration
# ============================================================

# ------------------------------------------------------------
# LLM Provider API Keys
# ------------------------------------------------------------

# Anthropic API key for Claude models (used by pydantic-ai agent)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key (optional, fallback or alternative LLM provider)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Model Configuration
# ------------------------------------------------------------

# The Claude model to use for extraction
# Available models: https://docs.anthropic.com/en/docs/about-claude/models
LLM_MODEL=claude-sonnet-4-5

# Maximum tokens for LLM response
LLM_MAX_TOKENS=4096

# Temperature for LLM (0.0 = deterministic, 1.0 = creative)
# Lower is better for structured extraction
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------

# FastAPI environment: development, staging, production
APP_ENV=development

# Host and port for FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable/disable interactive API docs at /docs and /redoc
ENABLE_DOCS=true

# ------------------------------------------------------------
# File Upload Configuration
# ------------------------------------------------------------

# Maximum allowed file size for uploads (in bytes)
# Default: 25 MB
MAX_UPLOAD_SIZE_BYTES=26214400

# Comma-separated list of allowed MIME types for uploads
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp

# Temporary directory for storing uploaded files during processing
UPLOAD_TEMP_DIR=/tmp/doc-extractor

# ------------------------------------------------------------
# OCR / PDF Processing (Optional)
# ------------------------------------------------------------

# Path to Tesseract OCR binary (if using OCR fallback for scanned PDFs)
# Install: https://tesseract-ocr.github.io/tessdoc/Installation.html
TESSERACT_CMD=/usr/bin/tesseract

# Path to Poppler binaries (required by pdf2image for PDF rasterization)
# Install: https://pdf2image.readthedocs.io/en/latest/installation.html
POPPLER_PATH=/usr/bin

# ------------------------------------------------------------
# API Security
# ------------------------------------------------------------

# API key for authenticating clients calling this service
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-secure-random-string

# Comma-separated list of allowed CORS origins
# Use "*" for development only; specify exact origins in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------------------------------------------------
# Rate Limiting (Optional)
# ------------------------------------------------------------

# Maximum number of requests per minute per client
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------
# Observability (Optional)
# ------------------------------------------------------------

# Logfire token for pydantic-ai observability and tracing
# Get yours at: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=

# Sentry DSN for error tracking (optional)
# Get yours at: https://sentry.io/settings/projects/
SENTRY_DSN=